FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY packages/manobal-identity /app/packages/manobal-identity
COPY pyproject.toml /app/pyproject.toml

RUN pip install --no-cache-dir -e packages/manobal-identity gunicorn

ENV DJANGO_SETTINGS_MODULE=manobal_identity.settings.local
EXPOSE 8000
CMD ["gunicorn", "manobal_identity.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
