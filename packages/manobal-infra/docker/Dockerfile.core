FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY packages/manobal-risk /app/packages/manobal-risk
COPY packages/manobal-core /app/packages/manobal-core
COPY rulesets /app/rulesets
COPY pyproject.toml /app/pyproject.toml

RUN pip install --no-cache-dir \
    -e packages/manobal-risk \
    -e packages/manobal-core \
    gunicorn

ENV DJANGO_SETTINGS_MODULE=manobal_core.settings.local
EXPOSE 8000
CMD ["gunicorn", "manobal_core.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
