#!/usr/bin/env python3
from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SCAN_ROOTS = (
    ROOT / "apps",
    ROOT / "packages",
    ROOT / "services" / "synth",
    ROOT / "infra" / "prompts",
    ROOT / "infra" / "corpus",
)
SKIP_PARTS = frozenset({"node_modules", ".next", "dist", "coverage", "__pycache__"})
FORBIDDEN_UNICODE = {
    "\u2014": "U+2014",
    "\u2013": "U+2013",
}
ALLOWED_PHRASE = re.compile(r"support,\s+not\s+surveillance", re.IGNORECASE)
BANNED_COPY = (
    re.compile(r"\bdiagnosis\b", re.IGNORECASE),
    re.compile(r"\bdisorder\b", re.IGNORECASE),
    re.compile(r"\bsuicide\s+risk\s+score\b", re.IGNORECASE),
    re.compile(r"\bmentally\s+ill\b", re.IGNORECASE),
    re.compile(r"\bunfit\b", re.IGNORECASE),
    re.compile(r"\babnormal\b", re.IGNORECASE),
    re.compile(r"\bsurveillance\b", re.IGNORECASE),
)


def source_files() -> list[Path]:
    files: list[Path] = []
    for scan_root in SCAN_ROOTS:
        if not scan_root.exists():
            continue
        for path in scan_root.rglob("*"):
            if not path.is_file() or SKIP_PARTS.intersection(path.parts):
                continue
            if path.stat().st_size <= 2_000_000:
                files.append(path)
    return sorted(files)


def check_file(path: Path) -> list[str]:
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return []

    failures: list[str] = []
    relative = path.relative_to(ROOT)
    for line_number, line in enumerate(text.splitlines(), start=1):
        for character, label in FORBIDDEN_UNICODE.items():
            if character in line:
                failures.append(f"{relative}:{line_number}: forbidden {label}")

        copy_line = ALLOWED_PHRASE.sub("", line)
        for pattern in BANNED_COPY:
            match = pattern.search(copy_line)
            if match:
                failures.append(
                    f"{relative}:{line_number}: banned copy {match.group(0)!r}"
                )
    return failures


def main() -> int:
    failures = [
        failure
        for path in source_files()
        for failure in check_file(path)
    ]
    if failures:
        print("\n".join(failures), file=sys.stderr)
        return 1
    print("Copy lint passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
