# Copy to .env for a live deployment. Local `make demo` works without these
# except the LLM key, which turns the Talk box into a real model.
# Do not commit real values.

# --- Demo listener (OpenAI-compatible). HTTPS only. ---
# Works with OpenAI, Groq, Together, or Azure OpenAI.
# Azure: set MANOBAL_LLM_BASE_URL to https://{resource}.openai.azure.com
# (or *.cognitiveservices.azure.com) and MANOBAL_LLM_MODEL to the deployment.
# Local demo also maps OPENAI_API_KEY, XAI_API_KEY / GROK_API_KEY,
# or AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT
# + optional AZURE_OPENAI_DEPLOYMENT and AZURE_OPENAI_API_VERSION.
# Prefer one listener: OpenAI (gpt-4o-mini) or xAI (grok-4-fast), not both.
MANOBAL_LLM_API_KEY=
MANOBAL_LLM_BASE_URL=https://api.openai.com/v1
MANOBAL_LLM_MODEL=gpt-4o-mini
MANOBAL_LLM_API_VERSION=2024-10-21
# auto | cloud | deterministic | edge
MANOBAL_AGENT_BACKEND=auto

# Speech-to-text for the phone Talk mic. Stays on Zone 2 — never in the app bundle.
MANOBAL_DEEPGRAM_API_KEY=
MANOBAL_DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
MANOBAL_DEEPGRAM_MODEL=nova-2

# --- Alerting (UC-05 / UC-10). Without these, dispatch stays in-process. ---
# FCM legacy server key. Push still needs each officer to register a device
# token at POST /v1/officer/destination. recipient_id is an actor id, not a token.
MANOBAL_FCM_SERVER_KEY=
# NIC SMS for T4 and enrolment OTP. URL must be https://
MANOBAL_NIC_SMS_USER=
MANOBAL_NIC_SMS_PASSWORD=
MANOBAL_NIC_SMS_SENDER=
MANOBAL_NIC_SMS_URL=

# --- HRMS nightly pull (FR-2.1). HTTPS JSON: {source_system, contract_version, records} ---
MANOBAL_HRMS_URL=
MANOBAL_HRMS_TOKEN=

# --- Optional object-store sidecar for journal blob delete (erasure). HTTPS only. ---
MANOBAL_OBJECT_PURGE_URL=
MANOBAL_OBJECT_PURGE_TOKEN=

# --- Helplines shown without opening a case (FR-1.12) ---
MANOBAL_HELPLINE_NATIONAL=112
MANOBAL_HELPLINE_KIRAN=1800-599-0019
MANOBAL_HELPLINE_FORCE=

# Set true only when you have FCM/SMS keys AND officer destinations registered.
MANOBAL_ALERT_IN_PROCESS=true
