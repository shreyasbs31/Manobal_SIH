COMPOSE_PROJECT_NAME=manobal

# Microsoft Foundry project endpoint for chat, embeddings, and other model classes. Entra auth via managed identity.
FOUNDRY_ENDPOINT=
# Foundry deployment name for the main GPT-5.x chat class.
AI_DEPLOYMENT_MAIN=
# Foundry deployment name for the fast GPT-5.x mini or nano class.
AI_DEPLOYMENT_FAST=
# Foundry deployment name for the open-weight gpt-oss-120b class.
AI_DEPLOYMENT_OPEN=
# Foundry deployment name for text-embedding-3-large.
AI_DEPLOYMENT_EMBED=
# Foundry deployment name for multilingual embeddings (Cohere embed v4).
AI_DEPLOYMENT_EMBED_ML=
# Foundry deployment name for retrieval rerank (Cohere rerank v4).
AI_DEPLOYMENT_RERANK=
# Foundry deployment name for the eval judge model.
AI_DEPLOYMENT_JUDGE=
# Foundry deployment name for illustration generation.
AI_DEPLOYMENT_IMAGE=
# Foundry deployment name for Azure OpenAI transcription used as STT fallback.
AI_DEPLOYMENT_STT_FALLBACK=
# Optional Foundry deployment name for Grok. Never used for personnel or safety tasks.
AI_DEPLOYMENT_ALT=
# Optional xAI API key when alt is served outside Foundry. Non-personnel tasks only.
XAI_API_KEY=
# OpenAI-compatible base URL for sovereign mode.
SOVEREIGN_LLM_BASE_URL=
# Optional OpenAI API key. Emergency officer-side fallback only, off by default.
OPENAI_API_KEY=
# OpenAI-compatible base URL when the OpenAI companion fallback is enabled.
OPENAI_BASE_URL=
# OpenAI model id used by the companion fallback.
OPENAI_MODEL=
# Set to 1 only to allow the OpenAI companion fallback when Foundry main or open is unset.
OPENAI_COMPANION_FALLBACK=
# Optional Azure OpenAI key if key auth is used instead of Entra.
AZURE_OPENAI_API_KEY=
# Optional Azure OpenAI resource endpoint if used instead of FOUNDRY_ENDPOINT.
AZURE_OPENAI_ENDPOINT=
# Optional Azure OpenAI deployment name if used instead of the AI_DEPLOYMENT_* map.
AZURE_OPENAI_DEPLOYMENT=
# Azure OpenAI API version for the v1 chat and embeddings path.
AZURE_OPENAI_API_VERSION=
# Voyage AI API key. Named embeddings fallback when Foundry embeddings are unset.
VOYAGE_API_KEY=

# Azure AI Content Safety resource endpoint for self-harm analysis and Prompt Shields.
CONTENT_SAFETY_ENDPOINT=
# Azure AI Content Safety subscription key. Leave empty to use Entra instead.
CONTENT_SAFETY_KEY=

# Azure AI Translator endpoint for UI translation and Hinglish transliteration.
TRANSLATOR_ENDPOINT=
# Azure AI Translator region header.
TRANSLATOR_REGION=
# Azure AI Translator subscription key. Leave empty to use Entra instead.
TRANSLATOR_KEY=

# Azure AI Speech region for STT and TTS (Hindi, Tamil, and other Indian locales).
SPEECH_REGION=
# Azure AI Speech endpoint. Overrides the region-derived STT and TTS URLs when set.
SPEECH_ENDPOINT=
# Azure AI Speech subscription key. Leave empty to use Entra instead.
SPEECH_KEY=
# Azure neural voice for Hindi TTS.
AZ_TTS_VOICE_HI=
# Azure bilingual Hindi-English voice for Hinglish TTS.
AZ_TTS_VOICE_HINGLISH=
# JSON map of language code to Azure neural voice for other locales.
AZ_TTS_VOICE_MAP=

# Deepgram API key for English streaming STT and Flux English TTS.
DEEPGRAM_API_KEY=
# Deepgram STT model for English (Nova-3 with Flux end-of-turn).
DG_STT_MODEL_EN=
# Deepgram STT model for Hindi (Nova-3 with language=hi).
DG_STT_MODEL_HI=
# Deepgram Flux Indian-accent English TTS voice.
DG_TTS_VOICE_EN=

# Azure Communication Services connection string for counsellor voice and video.
ACS_CONNECTION_STRING=
# Azure Communication Services endpoint when using managed identity instead of a connection string.
ACS_ENDPOINT=

# Twilio account SID for optional Dial-in Saathi (P2).
TWILIO_ACCOUNT_SID=
# Twilio auth token for optional Dial-in Saathi (P2).
TWILIO_AUTH_TOKEN=
# Twilio phone number for optional Dial-in Saathi (P2).
TWILIO_PHONE_NUMBER=
# Exotel SID for optional Dial-in Saathi (P2) if Twilio is not used.
EXOTEL_SID=
# Exotel API key for optional Dial-in Saathi (P2).
EXOTEL_API_KEY=
# Exotel API token for optional Dial-in Saathi (P2).
EXOTEL_API_TOKEN=
# Exotel API subdomain for optional Dial-in Saathi (P2).
EXOTEL_SUBDOMAIN=
# Exotel caller id or virtual number for optional Dial-in Saathi (P2).
EXOTEL_CALLER_ID=
