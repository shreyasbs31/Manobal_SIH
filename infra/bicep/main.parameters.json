{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=centralindia}"
    },
    "bootstrapMode": {
      "value": "${BOOTSTRAP_MODE=true}"
    },
    "imageTag": {
      "value": "${IMAGE_TAG=bootstrap}"
    },
    "publicEndpointEnabled": {
      "value": "${PUBLIC_ENDPOINT_ENABLED=false}"
    },
    "deployerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployerPrincipalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL=}"
    },
    "monthlyBudgetAmount": {
      "value": "${MONTHLY_BUDGET_AMOUNT=100000}"
    },
    "existingAiResourceGroup": {
      "value": "${AI_RESOURCE_GROUP=rg-manobal-ai}"
    },
    "wafMode": {
      "value": "${WAF_MODE=Detection}"
    }
  }
}
